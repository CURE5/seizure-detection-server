# Seizure Detection Server Configuration

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# --- Email Notifications (SMTP) ---
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
NOTIFY_EMAIL_TO=parent1@email.com,parent2@email.com

# Gmail App Password instructions:
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an app password for "Mail"
# 4. Use that 16-character password as SMTP_PASSWORD

# --- SMS Notifications (Twilio) ---
NOTIFY_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890
NOTIFY_SMS_TO=+1234567890,+0987654321

# Twilio setup instructions:
# 1. Sign up at https://www.twilio.com/
# 2. Get free trial credits
# 3. Copy Account SID and Auth Token from dashboard
# 4. Get a phone number from Twilio console

# --- Push Notifications (Pushover) ---
NOTIFY_PUSHOVER_ENABLED=false
PUSHOVER_USER_KEY=your-user-key
PUSHOVER_API_TOKEN=your-api-token
PUSHOVER_PRIORITY=2

# Pushover setup instructions:
# 1. Sign up at https://pushover.net/ ($5 one-time)
# 2. Create an application to get API token
# 3. Find your user key in dashboard
# Priority: -2=lowest, -1=low, 0=normal, 1=high, 2=emergency

# --- Webhook Notifications (Generic) ---
NOTIFY_WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com/alert
WEBHOOK_AUTH_TOKEN=your-bearer-token

# Example webhook receivers:
# - Discord: Create webhook in channel settings
# - Slack: Create incoming webhook in app settings
# - Custom server: POST endpoint accepting JSON

# =============================================================================
# DETECTION SETTINGS
# =============================================================================

# --- Shadow Mode ---
# Set to true to log detections without sending alerts (for testing)
SHADOW_MODE=false

# --- Notify-Only Mode ---
# When true, AI-detected events (visual or HR) ONLY push notifications.
# No seizure log entry, no auto-record, no is_seizing state flip.
# Caregiver confirms manually via POST /sz if the event is real.
# Recommended default for unreliable AI detectors. Independent from SHADOW_MODE.
DETECTION_ALERT_NOTIFY_ONLY=true

# --- Alert Cooldown ---
# Minimum seconds between alerts (prevents spam)
ALERT_COOLDOWN_SECONDS=30

# --- Auto Recording ---
# Automatically start video recording on seizure detection
AUTO_RECORD_ON_DETECTION=true
AUTO_RECORD_DURATION_SECONDS=300

# --- Confidence Thresholds ---
# Custom model threshold (0.0-1.0)
CUSTOM_MODEL_THRESHOLD=0.5
# Generic detector threshold (0.0-1.0)
ACTIVITY_THRESHOLD=0.7

# --- Time Weighting ---
# Enable time-of-day sensitivity adjustment
ENABLE_TIME_WEIGHTING=true
# High-risk hours (5-8 AM for hypermotor seizures)
HIGH_RISK_START_HOUR=5
HIGH_RISK_END_HOUR=8
HIGH_RISK_MULTIPLIER=1.5

# =============================================================================
# CUSTOM MODEL SETTINGS
# =============================================================================

# Use custom trained ONNX model
USE_CUSTOM_MODEL=true
CUSTOM_MODEL_PATH=models/hypermotor_detector.onnx

# =============================================================================
# CAMERA SETTINGS
# =============================================================================

# Camera indices (0=default, 1=second camera)
DAY_CAMERA_NUM=0
NIGHT_CAMERA_NUM=1

# Video resolution
VIDEO_WIDTH=640
VIDEO_HEIGHT=360

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Example 1: Email Only (Gmail)
# NOTIFY_EMAIL_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=myemail@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM=myemail@gmail.com
# NOTIFY_EMAIL_TO=parent@email.com

# Example 2: SMS Only (Twilio)
# NOTIFY_SMS_ENABLED=true
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15551234567
# NOTIFY_SMS_TO=+15559876543

# Example 3: Push Only (Pushover)
# NOTIFY_PUSHOVER_ENABLED=true
# PUSHOVER_USER_KEY=uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUSHOVER_API_TOKEN=axxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUSHOVER_PRIORITY=2

# Example 4: All Notifications
# NOTIFY_EMAIL_ENABLED=true
# NOTIFY_SMS_ENABLED=true
# NOTIFY_PUSHOVER_ENABLED=true
# (configure all settings above)

# Example 5: Testing/Development (Console Only)
# NOTIFY_EMAIL_ENABLED=false
# NOTIFY_SMS_ENABLED=false
# NOTIFY_PUSHOVER_ENABLED=false
# SHADOW_MODE=true

# Minutes of stillness before the subject is considered asleep (wake detection)
WAKEUP_SLEEP_THRESHOLD_MINUTES=30

# =============================================================================
# MULTI-STAGE DETECTION PIPELINE
# =============================================================================

# Stage 1: Basic Motion Detection (Gate)
# Optical flow-based motion detection to filter out static frames
MOTION_THRESHOLD=25              # Pixel intensity threshold for considering motion
MOTION_DEGREE_THRESHOLD=0.003    # Percentage of frame that must show motion (0.3%)
                                 # Data-driven: Catches 90% of seizures (min=0.002, analysis: Dec 2025)

# Stage 2: Activity Detection (Gate) - PROBLEMATIC
# Motion-based activity patterns to detect seizure-like movements
# NOTE: Training data shows activity detector returns 0.0-0.015 for BOTH seizure and normal videos
#       Current implementation does NOT effectively distinguish seizures from normal movements
ACTIVITY_THRESHOLD=0.005         # Activity score threshold (0.0 to 1.0)
                                 # Data-driven: Max seizure=0.010, analysis shows poor discrimination
                                 # Consider DISABLING this gate (set to 0.0) or reimplementing detector

# Stage 3: Motion LSTM Model (DISABLED - too many false positives)
# Earlier motion-based ML model, kept for reference but not recommended
USE_MOTION_MODEL=false
MOTION_MODEL_PATH=models/motion_seizure_detector.onnx
MOTION_MODEL_THRESHOLD=0.8

# Stage 4: Pose-based Model (PRIMARY DETECTOR)
# MediaPipe 33-landmark pose analysis with ONNX model
# This is the main detector, only activated when Stage 1 & 2 gates pass
USE_POSE_MODEL=false
POSE_MODEL_PATH=models/hypermotor_detector.onnx
POSE_MODEL_THRESHOLD=0.5         # Validated threshold (99.6% recall, 3.5% FPR)

# Alert strategy: onset_only, onset_and_ongoing, onset_and_offset, any_model, both_models
ALERT_STRATEGY=onset_only

# =============================================================================
# RHYTHMIC SEIZURE PATTERN DETECTION (Hypermotor Seizures)
# =============================================================================

# Hypermotor seizures show rhythmic patterns: spasm -> calm (4-20s) -> spasm
# These settings handle the calm periods between spasms vs true seizure end

# Maximum gap between spasms during active seizure (seconds)
# Allows for normal calm periods between spasms without ending seizure
INTRA_SEIZURE_MAX_GAP=30.0

# Minimum time without activity to declare seizure ended (seconds)
# Only after this long without any spasms is the seizure considered over
SEIZURE_END_THRESHOLD=60.0

# =============================================================================
# GARMIN HEART RATE / HR-BASED DETECTION (optional)
# =============================================================================
# Optional second detector that consumes BLE Heart Rate Profile (0x180D)
# broadcasts from a Garmin watch. Independent alert path with its own
# baseline + sustain logic. Requires `bleak`: uv pip install bleak
#
# On the watch: Settings -> Sensors & Accessories -> Wrist Heart Rate
#   -> Broadcast Heart Rate -> Broadcast Now (leave that screen on)

# Master switch.
ENABLE_GARMIN_HR=false

# Send a notification when the HR detector fires. Runtime-toggleable from the
# FE via POST /command {action: "notify_on_hr_spike", value: true|false}.
# When false, the detector still runs (baseline, logging, /status) — only the
# notification fan-out is gated.
NOTIFY_ON_HR_SPIKE=false

# Optional fixed BLE MAC address. Empty = auto-discover by name/HR-service advert.
GARMIN_HR_ADDRESS=
GARMIN_HR_NAME_FILTER=garmin

# BLE timing. Watch stops broadcasting when not worn, so we periodically rescan.
GARMIN_HR_SCAN_TIMEOUT_SEC=10
GARMIN_HR_RESCAN_INTERVAL_SEC=30
GARMIN_HR_RECONNECT_DELAY_SEC=5

# Detector parameters (tune to the wearer's resting baseline).
HR_BASELINE_WINDOW_SEC=600       # rolling baseline window (trimmed median)
HR_DELTA_THRESHOLD=15            # bpm above baseline -> trigger A
HR_ABSOLUTE_THRESHOLD=100        # absolute bpm floor -> trigger B
HR_SUSTAIN_SEC=20                # required duration above either threshold
HR_STALE_SEC=10                  # /status shows "stale" if reading older than this
HR_ALERT_COOLDOWN_SEC=60         # cooldown between HR alerts
HR_LOG_FLUSH_SEC=300             # flush data_logs/hr_*.jsonl every N seconds
